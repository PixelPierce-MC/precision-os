[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='red'
gtk-theme='WhiteSur-Dark-red'
icon-theme='WhiteSur-red-dark'
cursor-theme='WhiteSur-cursors'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
enable-hot-corners=true
clock-show-weekday=true
clock-show-date=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Inter Bold 11'
focus-mode='click'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/precision-os/precision-os.svg'
picture-uri-dark='file:///usr/share/backgrounds/precision-os/precision-os.svg'
primary-color='#0D0D0D'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/precision-os/precision-os.svg'
primary-color='#0D0D0D'

[org/gnome/mutter]
dynamic-workspaces=true
workspaces-only-on-primary=true
edge-tiling=true
experimental-features=['scale-monitor-framebuffer','variable-refresh-rate']

[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com','dash-to-dock@micxgx.gmail.com','blur-my-shell@aunetx','appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['org.gnome.Nautilus.desktop','steam.desktop','org.prismlauncher.PrismLauncher.desktop','com.obsproject.Studio.desktop','com.spotify.Client.desktop','org.gnome.Ptyxis.desktop','org.mozilla.firefox.desktop']

[org/gnome/shell/app-switcher]
current-workspace-only=true

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark-red'

# Dash to Dock: key names confirmed against the extension's published gschema.
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
intellihide=true
extend-height=false
multi-monitor=false
transparency-mode='FIXED'
custom-background-color=true
background-color='#0D0D0D'
background-opacity=0.55
running-indicator-style='DOTS'
custom-theme-shrink=true
dash-max-icon-size=52
icon-size-fixed=true
show-apps-at-top=false
show-trash=true
show-mounts=false
click-action='focus-or-previews'
apply-custom-theme=false

# Blur my Shell (v6x+/pipeline-based). Schema ids/paths confirmed; sigma/brightness now live inside
# pipelines (tune in the extension prefs, then `dconf dump /org/gnome/shell/extensions/blur-my-shell/`).
[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
pipeline='pipeline_default'
override-background=true
style-panel=0

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true
pipeline='pipeline_default'
static-blur=true
override-background=true
style-dash-to-dock=0

[org/gnome/shell/extensions/blur-my-shell/overview]
blur=true
pipeline='pipeline_default'

# Ptyxis: palette is stored per profile, by palette *display name*; profiles are listed by UUID.
[org/gnome/Ptyxis]
interface-style='dark'
profile-uuids=['a7c3e9d2b4f84c1e9a6d5b0c3e7f1a22']
default-profile-uuid='a7c3e9d2b4f84c1e9a6d5b0c3e7f1a22'

[org/gnome/Ptyxis/Profiles/a7c3e9d2b4f84c1e9a6d5b0c3e7f1a22]
label='PrecisionOS'
palette='PrecisionOS'
opacity=0.96
